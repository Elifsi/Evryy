# ─────────────────────────────────────────────────────────────────────────────
# evrry — Environment Variable Reference
# Company: Elifsi Technologies Private Limited
#
# Copy the relevant section to the appropriate .env.local file:
#   Prototype:            prototype/Phone/.env.local
#   Consumer Web:         apps/web/consumer/.env.local
#   Partner Web:          apps/web/partner/.env.local
#
# CRITICAL SECURITY RULES:
# 1. Never commit real secret values to Git.
# 2. Never place private keys or service-role keys in client code or client bundles.
# 3. All payment verification and privileged operations must happen server-side.
# ─────────────────────────────────────────────────────────────────────────────

# ── prototype/Phone — AI Provider Keys (Optional) ──────────────────────────────
# In the prototype, without any key the concierge falls back to a rule-based agent.
# Checked in order: GEMINI_API_KEY → ANTHROPIC_API_KEY → OPENROUTER_API_KEY
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── prototype/Phone — E2E Chat WebSocket Relay ─────────────────────────────────
CHAT_RELAY_PORT=8787
NEXT_PUBLIC_CHAT_RELAY_PORT=8787

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE — Shared Backend for Consumer & Partner Apps
# ─────────────────────────────────────────────────────────────────────────────

# ── Public Credentials (Safe for Client Apps: Android, iOS, Web) ──────────────
# Used by Supabase Client SDKs with Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Native Android / iOS client configurations:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ── Local Development (Supabase CLI) ──────────────────────────────────────────
# SUPABASE_LOCAL_URL=http://localhost:54321
# SUPABASE_LOCAL_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# ⛔ SERVER-SIDE SECRETS — NEVER EXPOSE TO CLIENT APPLICATIONS ⛔
# Store these in Supabase Edge Functions using `supabase secrets set`
# or in server-side deployment environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Service Role Key (Bypasses ALL Row Level Security)
# SUPABASE_SERVICE_ROLE_KEY=

# Payment Provider Gateway Secrets (Server-Side Only)
# ESEWA_MERCHANT_CODE=
# ESEWA_SECRET_KEY=
# KHALTI_SECRET_KEY=
# FONEPAY_MERCHANT_CODE=
# FONEPAY_SECRET_KEY=
# CARD_GATEWAY_SECRET_KEY=

# Resend Transactional Email API Key (Server-Side Only)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="evrry <noreply@evrry.com>"
