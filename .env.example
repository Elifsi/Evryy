# ─────────────────────────────────────────────────────────────────────────────
# evrry — Master Environment Variable & Secrets Reference
# Company: Elifsi Technologies Private Limited
#
# ALL API KEYS & SECRETS ARE MANAGED FROM THIS SINGLE MASTER TEMPLATE.
# To configure your environment:
#   1. Copy this file to `.env.local` in this root directory.
#   2. Fill in your keys in the sections below.
#   3. Run `bash scripts/sync-secrets.sh` to upload backend secrets to Supabase in 1 click!
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# 1. PUBLIC SUPABASE CREDENTIALS (Safe for Client Apps: Android, iOS, Web)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# =============================================================================
# 2. SUPABASE BACKEND SERVICE CREDENTIALS (Server-Side Only)
# =============================================================================
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# =============================================================================
# 3. AI & LLM PROVIDER KEYS (OpenRouter, Gemini, Anthropic)
#    (Used by ai-gateway Edge Function & Voice Concierge)
# =============================================================================
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# =============================================================================
# 4. PHONE AUTHENTICATION & OTP GATEWAYS (WhatsApp Primary + Domestic SMS Fallback)
# =============================================================================
# Primary Channel: Meta WhatsApp Business Cloud API (Graph API v21.0)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
