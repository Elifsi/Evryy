# evrry — Prototype web app environment variables
# Company: Elifsi Technologies Private Limited
# Copy this file to .env.local and fill in values you want to use.
# The app runs fully with zero config (rule-based AI fallback is built in).

# ── AI provider keys ──────────────────────────────────────────────────────────
# Optional. Without any key the AI concierge falls back to a small
# rule-based demo agent so the app still runs end-to-end with zero config.
#
# Checked in this order: GEMINI_API_KEY, then ANTHROPIC_API_KEY, then
# OPENROUTER_API_KEY. Get a free Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── E2E chat relay (server/chat-relay.mjs) ────────────────────────────────────
# Optional — both default to 8787.
# Only needs to change if that port is taken, or you're reverse-proxying it.
CHAT_RELAY_PORT=8787
NEXT_PUBLIC_CHAT_RELAY_PORT=8787

# ── Resend Transactional Email (Invoices, Verification & Alerts) ─────────────
# Get a free API key at https://resend.com (3,000 free emails/month)
# If left empty, emails will run in mock mode and log cleanly to console.
RESEND_API_KEY=
RESEND_FROM_EMAIL="evrry <noreply@evrry.com>"
